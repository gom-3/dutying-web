        "lucide-react": "^0.562.0",
        "luxon": "^3.7.2",
        "motion": "^12.40.0",
        "puppeteer": "^24.31.0",
        "qs": "^6.14.0",
        "react": "^19.2.0",
        "react-cool-onclickoutside": "^1.7.0",
        "react-dom": "^19.2.0",
        "react-draggable": "^4.5.0",
        "react-facebook-pixel": "^1.0.4",
        "react-ga4": "^2.1.0",
        "react-helmet": "^6.1.0",
        "react-hook-form": "^7.67.0",
        "react-hot-toast": "^2.6.0",
        "react-i18next": "^16.5.0",
