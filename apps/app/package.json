{
    "name": "@dutying/app",
    "private": true,
    "version": "1.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "lint": "eslint src",
        "format": "prettier --write .",
        "svgr": "npx @svgr/cli@latest -d src/shared/assets/svg --typescript --no-dimensions --no-prettier public/svg",
        "test": "vitest",
        "test:run": "vitest run",
        "test:ui": "vitest --ui",
        "check:i18n-literals": "node scripts/scan-i18n-literals.mjs",
        "i18n:import-current": "node scripts/i18n-import-current-locales.mjs",
        "i18n:sync-server-errors": "node scripts/i18n-sync-server-errors.mjs",
        "i18n:catalog:check": "node scripts/i18n-check-catalog.mjs",
        "i18n:export:web": "node scripts/i18n-export-web.mjs",
        "i18n:review": "node scripts/i18n-build-review.mjs",
        "check:i18n": "pnpm check:i18n-literals && pnpm i18n:catalog:check",
        "check:i18n-ui": "node scripts/check-i18n-ui.mjs",
        "coverage": "vitest run --coverage",
        "cypress:open": "cypress open",
        "e2e": "start-server-and-test dev http://localhost:3000 cypress:open",
        "type-check": "tsc -b"
    },
    "dependencies": {
        "@dutying/api": "workspace:*",
        "@dutying/domain": "workspace:*",
        "@dutying/utils": "workspace:*",
