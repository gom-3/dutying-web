---
import {landingPrimaryCtas, siteConfig} from '../../config/site';

const appStoreLink = 'https://abr.ge/bv13wa';
const inquiryLink = 'https://ye620.channel.io';

const featureSections = [
    {
        id: 'mobile',
        product: 'App',
        label: '홈',
        title: ['근무관리부터', '개인 일정까지 한번에'],
        description: ['매월 근무 등록하고', '개인 일정을 유형별로 관리해보세요.'],
        desktopImage: '/img/landing_4.webp',
        mobileImage: '/img/landing_mobile_4.webp',
        tone: 'light',
        align: 'start',
    },
    {
        product: 'App',
        label: '소셜 (친구 · 모임)',
        title: ['동료의 근무 일정을', '한눈에'],
        description: ['동료와 친구를 맺어', '일정을 편하게 조율해보세요.'],
        desktopImage: '/img/landing_5.webp',
        mobileImage: '/img/landing_mobile_5.webp',
        tone: 'dark',
        align: 'end',
    },
    {
        id: 'web',
        product: 'Web',
        label: '근무표 만들기',
        title: ['복잡한 근무표 작성을', '간편하게 자동으로!'],
        description: ['직접 편집한 제약 조건들에 딱 맞는', '근무표를 작성해드릴게요.'],
        desktopImage: '/img/landing_2.webp',
        mobileImage: '/img/landing_mobile_2.webp',
        tone: 'dark',
        align: 'end',
    },
    {
        product: 'Web',
        label: '근무표 만들기',
        title: ['더 꼼꼼하게,', '하지만 더 편리하게'],
        description: ['근무표 작성을 돕기 위한', '여러 보조 기능들이 마련되어 있습니다.'],
        desktopImage: '/img/landing_3.webp',
        mobileImage: '/img/landing_mobile_3.webp',
        tone: 'dark',
        align: 'start',
    },
];

const formattedFeatureSections = featureSections.map((section) => ({
    ...section,
    titleHtml: section.title.join('<br />'),
    descriptionHtml: section.description.join('<br />'),
}));
---

<main class="landing-page">
    <section class="desktop-only landing-header">
        <div class="landing-header__inner">
            <a class="brand" href={siteConfig.marketingOrigin} aria-label="듀팅 랜딩 홈">
                <img src="/logo.svg" alt="" width="32" height="32" />
                <span>dutying</span>
            </a>

            <nav class="landing-header__nav" aria-label="랜딩 섹션">
                <a href="#mobile">모바일 앱 주요 기능</a>
                <a href="#web">웹 주요 기능</a>
            </nav>

            <div class="landing-header__actions">
                <a href={appStoreLink} target="_blank" rel="noreferrer">다운로드</a>
                <a href={inquiryLink} target="_blank" rel="noreferrer">문의하기</a>
                <a class="button button--primary button--compact" href={siteConfig.appLinks.login}>로그인</a>
            </div>
        </div>
    </section>

    <section class="mobile-only landing-mobile-header">
        <div class="landing-mobile-header__inner">
            <a class="brand brand--mobile" href={siteConfig.marketingOrigin} aria-label="듀팅 랜딩 홈">
                <img src="/logo.svg" alt="" width="28" height="28" />
                <span>dutying</span>
            </a>

            <a class="button button--primary button--compact" href={appStoreLink} target="_blank" rel="noreferrer">다운로드</a>
        </div>
    </section>

    <section class="desktop-only hero hero--desktop" style={`--hero-image:url('/img/landing_1.webp')`}>
        <div class="hero__content hero__content--desktop">
            <div>
                <h1>
                    듀팅,
                    <br />
                    이제 더 간편하게!
                </h1>

                <div class="hero-copy-group">
                    <div class="copy-line">
                        <span class="pill pill--highlight">App</span>
                        <p>일정 관리의 모든 여정이 더 편리해지는 경험을 제공합니다.</p>
                    </div>
                    <div class="copy-line">
                        <span class="pill pill--highlight">Web</span>
                        <p>근무표를 더 쉽고 빠르게 작성할 수 있도록 도와드립니다.</p>
                    </div>
                </div>

                <div class="cta-block">
                    <div class="cta-block__heading">
                        <span class="pill pill--highlight">App</span>
                        <p>근무 일정 관리 (일반 간호사 용)</p>
                    </div>
                    <div class="cta-row">
                        <a class="button button--store" href={appStoreLink} target="_blank" rel="noreferrer">Google Play</a>
                        <a class="button button--store" href={appStoreLink} target="_blank" rel="noreferrer">App Store</a>
                    </div>
                </div>

                <div class="cta-block">
                    <div class="cta-block__heading">
                        <span class="pill pill--highlight">Web</span>
                        <p>근무표 작성 (수간호사 용)</p>
                    </div>
                    <div class="cta-row">
                        {landingPrimaryCtas.map((cta) => (
                            <a class="button button--store" href={cta.href}>{cta.label}</a>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="mobile-only hero hero--mobile" style={`--hero-image:url('/img/landing_mobile_1.webp')`}>
        <div class="hero__content hero__content--mobile">
            <h1>
                근무표,
                <br />
                이제 더 간편하게!
            </h1>

            <div class="cta-block cta-block--mobile">
                <div class="cta-block__heading">
                    <span class="pill pill--highlight">App</span>
                    <p>근무 일정 관리 (일반 간호사 용)</p>
                </div>
                <div class="cta-row cta-row--mobile">
                    <a class="button button--store button--mobile" href={appStoreLink} target="_blank" rel="noreferrer">Google Play</a>
                    <a class="button button--store button--mobile" href={appStoreLink} target="_blank" rel="noreferrer">App Store</a>
                </div>
            </div>
        </div>
    </section>

    {formattedFeatureSections.map((section) => (
        <div class="feature-pair">
            <section
                id={section.id}
                class:list={['desktop-only', 'feature-section', section.align === 'end' ? 'feature-section--end' : 'feature-section--start']}
                style={`--feature-image:url('${section.desktopImage}')`}
            >
                <div class="feature-section__inner">
                    <article class:list={['feature-copy', section.tone === 'light' ? 'feature-copy--light' : 'feature-copy--dark']}>
                        <div class="feature-copy__label">
                            <span class:list={['pill', section.tone === 'light' ? 'pill--light' : 'pill--highlight']}>{section.product}</span>
                            <p>{section.label}</p>
                        </div>
                        <h2 set:html={section.titleHtml} />
                        <p set:html={section.descriptionHtml} />
                    </article>
                </div>
            </section>

            <section class="mobile-only mobile-feature" style={`--feature-image:url('${section.mobileImage}')`}>
                <div class="mobile-feature__inner">
                    <article class:list={['feature-copy', 'feature-copy--mobile', section.tone === 'light' ? 'feature-copy--light' : 'feature-copy--dark']}>
                        <div class="feature-copy__label">
                            <span class:list={['pill', section.tone === 'light' ? 'pill--light' : 'pill--highlight']}>{section.product}</span>
                            <p>{section.label}</p>
                        </div>
                        <h2 set:html={section.titleHtml} />
                        <p set:html={section.descriptionHtml} />
                    </article>
                </div>
            </section>
        </div>
    ))}

    <footer class="desktop-only landing-footer">
        <div class="landing-footer__inner">
            <section>
                <h2>듀팅 다운로드</h2>

                <div class="footer-row">
                    <span>모바일 앱</span>
                    <div class="cta-row">
                        <a class="button button--footer" href={appStoreLink} target="_blank" rel="noreferrer">Google Play</a>
                        <a class="button button--footer" href={appStoreLink} target="_blank" rel="noreferrer">App Store</a>
                    </div>
                </div>

                <div class="footer-row">
                    <span>웹</span>
                    <div class="cta-row">
                        <a class="button button--footer" href={siteConfig.appLinks.makeEntry}>근무표 작성 체험하기</a>
                        <a class="button button--footer" href={siteConfig.appLinks.make}>근무표 만들기</a>
                    </div>
                </div>
            </section>

            <section class="landing-footer__links">
                <a href={inquiryLink} target="_blank" rel="noreferrer">제휴 문의</a>
            </section>
        </div>

        <div class="landing-footer__bottom">
            <a href={siteConfig.legal.terms} target="_blank" rel="noreferrer">이용 약관</a>
            <a href={siteConfig.legal.terms} target="_blank" rel="noreferrer">개인 정보 처리 방침</a>
        </div>
    </footer>

    <footer class="mobile-only landing-footer landing-footer--mobile">
        <div class="landing-footer__inner landing-footer__inner--mobile">
            <section>
                <h2>듀팅 다운로드</h2>

                <div class="footer-column">
                    <span>모바일 앱</span>
                    <div class="cta-row cta-row--mobile">
                        <a class="button button--footer button--mobile" href={appStoreLink} target="_blank" rel="noreferrer">Google Play</a>
                        <a class="button button--footer button--mobile" href={appStoreLink} target="_blank" rel="noreferrer">App Store</a>
                    </div>
                </div>

                <div class="footer-column">
                    <span>웹</span>
                    <div class="cta-row cta-row--mobile">
                        <a class="button button--footer button--mobile" href={siteConfig.appLinks.makeEntry}>근무표 작성 체험하기</a>
                        <a class="button button--footer button--mobile" href={siteConfig.appLinks.make}>근무표 만들기</a>
                    </div>
                </div>

                <a class="footer-contact" href={inquiryLink} target="_blank" rel="noreferrer">제휴 문의</a>
            </section>
        </div>

        <div class="landing-footer__bottom landing-footer__bottom--mobile">
            <a href={siteConfig.legal.terms} target="_blank" rel="noreferrer">이용 약관</a>
            <a href={siteConfig.legal.terms} target="_blank" rel="noreferrer">개인 정보 처리 방침</a>
        </div>
    </footer>
</main>

<style>
    .landing-page {
        color: #150b3c;
        background: #fff;
    }

    .landing-page a {
        color: inherit;
        text-decoration: none;
    }

    .desktop-only {
        display: block;
    }

    .mobile-only {
        display: none;
    }

    .landing-header,
    .landing-mobile-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(14px);
    }

    .landing-header__inner,
    .landing-mobile-header__inner,
    .hero__content--desktop,
    .feature-section__inner,
    .landing-footer__inner,
    .landing-footer__bottom {
        width: min(1200px, calc(100% - 48px));
        margin: 0 auto;
    }

    .landing-header__inner {
        display: flex;
        align-items: center;
        height: 72px;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: -0.03em;
    }

    .brand img,
    .brand--mobile img {
        display: block;
        width: 32px;
        height: 32px;
    }

    .landing-header__nav {
        display: flex;
        gap: 45px;
        margin-left: auto;
        padding-right: 60px;
        border-right: 1px solid #e5e3eb;
    }

    .landing-header__nav a,
    .landing-header__actions a {
        font-size: 1.125rem;
        font-weight: 500;
    }

    .landing-header__nav a {
        color: #71698d;
        text-decoration: underline;
        text-underline-offset: 5px;
    }

    .landing-header__actions {
        display: flex;
        align-items: center;
        gap: 32px;
        margin-left: 48px;
    }

    .landing-header__actions > a:not(.button),
    .landing-footer__links a,
    .landing-footer__bottom a,
    .footer-contact {
        color: #595961;
    }

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 15px;
        font-size: 1.5rem;
        font-weight: 600;
        line-height: 1;
        cursor: pointer;
        transition:
            transform 160ms ease,
            box-shadow 160ms ease,
            background-color 160ms ease;
    }

    .button:hover {
        transform: translateY(-1px);
    }

    .button--primary {
        background: #663dfa;
        color: #fff;
    }

    .button--compact {
        min-height: 40px;
        padding: 0 16px;
        border-radius: 30px;
        font-size: 1.125rem;
    }

    .button--store,
    .button--footer {
        min-width: 245px;
        min-height: 60px;
        padding: 0 24px;
        background: #fff;
        color: #150b3c;
        box-shadow: 0 20px 50px rgba(18, 20, 31, 0.12);
    }

    .button--footer {
        min-width: 170px;
        min-height: 38px;
        border-radius: 8px;
        background: #f5f5f7;
        box-shadow: none;
        font-size: 1rem;
    }

    .hero,
    .feature-section,
    .mobile-feature {
        background-image: var(--hero-image, var(--feature-image));
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
    }

    .hero--desktop,
    .feature-section {
        min-height: 100svh;
    }

    .hero__content--desktop {
        display: flex;
        align-items: center;
        min-height: calc(100svh - 72px);
        padding: 88px 0 80px;
    }

    .hero__content--desktop > div {
        max-width: 640px;
    }

    .hero h1,
    .feature-copy h2 {
        margin: 0;
        letter-spacing: -0.04em;
    }

    .hero h1 {
        font-size: clamp(3.4rem, 5vw, 4rem);
        line-height: 1.28;
        color: #fff;
    }

    .hero-copy-group {
        display: grid;
        gap: 9px;
        margin-top: 35px;
    }

    .copy-line,
    .cta-block__heading,
    .feature-copy__label {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .copy-line p,
    .cta-block__heading p {
        margin: 0;
        font-size: 14px;
        font-weight: 500;
        color: #fff;
    }

    .cta-block {
        margin-top: 45px;
    }

    .cta-block + .cta-block {
        margin-top: 40px;
    }

    .cta-block__heading p {
        color: #d2cadf;
    }

    .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        margin-top: 12px;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 62px;
        height: 30px;
        padding: 0 8px;
        border-radius: 5px;
        font-size: 1.25rem;
        line-height: 1;
    }

    .pill--highlight {
        background: #efe7ff;
        color: #663dfa;
    }

    .pill--light {
        background: #fff;
        color: #663dfa;
    }

    .feature-section--end .feature-section__inner {
        display: flex;
        justify-content: flex-end;
    }

    .feature-section__inner {
        display: flex;
        align-items: flex-start;
        min-height: 100svh;
        padding-top: 142px;
    }

    .feature-copy {
        width: min(450px, 100%);
    }

    .feature-copy__label p,
    .feature-copy p {
        margin: 0;
    }

    .feature-copy__label p {
        font-size: 1.5rem;
        font-weight: 500;
    }

    .feature-copy h2 {
        margin-top: 12px;
        font-size: 3.25rem;
        line-height: 1.42;
    }

    .feature-copy > p {
        margin-top: 42px;
        font-size: 1.75rem;
        line-height: 1.55;
        font-weight: 500;
    }

    .feature-copy--light .feature-copy__label p {
        color: #663dfa;
    }

    .feature-copy--light h2 {
        color: #fff;
    }

    .feature-copy--light > p {
        color: rgba(253, 252, 254, 0.7);
    }

    .feature-copy--dark .feature-copy__label p {
        color: #663dfa;
    }

    .feature-copy--dark h2 {
        color: #150b3c;
    }

    .feature-copy--dark > p {
        color: #6b6780;
    }

    .landing-footer {
        background: #fff;
        padding: 110px 0 28px;
    }

    .landing-footer__inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 220px;
        gap: 64px;
    }

    .landing-footer h2 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
        color: #46404f;
    }

    .footer-row,
    .footer-column {
        display: grid;
        gap: 16px;
        margin-top: 24px;
    }

    .footer-row {
        grid-template-columns: 96px minmax(0, 1fr);
        align-items: center;
        gap: 24px;
    }

    .footer-row span,
    .footer-column span {
        font-size: 14px;
        font-weight: 500;
        color: #595961;
    }

    .landing-footer__links {
        display: flex;
        justify-content: flex-end;
        align-items: flex-start;
        padding-top: 6px;
        font-size: 1.25rem;
        font-weight: 500;
    }

    .landing-footer__bottom {
        display: flex;
        gap: 24px;
        margin-top: 44px;
        padding-top: 24px;
        border-top: 1px solid #e5e3eb;
    }

    .landing-footer__bottom a {
        font-size: 1rem;
        font-weight: 700;
    }

    @media (max-width: 900px) {
        .desktop-only {
            display: none;
        }

        .mobile-only {
            display: block;
        }

        .landing-mobile-header__inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 60px;
            width: calc(100% - 32px);
        }

        .brand--mobile {
            gap: 8px;
            font-size: 1rem;
        }

        .button--compact {
            min-height: 30px;
            padding: 0 12px;
            font-size: 0.75rem;
        }

        .hero--mobile,
        .mobile-feature {
            min-height: 100svh;
        }

        .hero__content--mobile,
        .mobile-feature__inner,
        .landing-footer__inner--mobile,
        .landing-footer__bottom--mobile {
            width: calc(100% - 32px);
            margin: 0 auto;
        }

        .hero__content--mobile {
            display: flex;
            flex-direction: column;
            min-height: calc(100svh - 60px);
            padding: 90px 0 48px;
        }

        .hero__content--mobile h1 {
            font-size: 2rem;
            line-height: 1.32;
            color: #663dfa;
        }

        .cta-block--mobile {
            margin-top: auto;
        }

        .cta-row--mobile {
            gap: 10px;
        }

        .button--mobile {
            min-width: 0;
            flex: 1;
            min-height: 38px;
            padding: 0 10px;
            border-radius: 8px;
            font-size: 1rem;
        }

        .mobile-feature__inner {
            min-height: 100svh;
            padding-top: 124px;
        }

        .feature-copy--mobile {
            width: min(320px, 100%);
        }

        .feature-copy--mobile .feature-copy__label p {
            font-size: 0.875rem;
        }

        .feature-copy--mobile h2 {
            margin-top: 34px;
            font-size: 1.5rem;
            line-height: 1.58;
        }

        .feature-copy--mobile > p {
            margin-top: 16px;
            font-size: 1rem;
            line-height: 1.5;
        }

        .landing-footer--mobile {
            padding: 62px 0 24px;
        }

        .landing-footer__inner--mobile {
            display: block;
        }

        .footer-contact {
            display: inline-block;
            margin-top: 62px;
            font-size: 1rem;
            font-weight: 500;
        }

        .landing-footer__bottom--mobile {
            gap: 20px;
            margin-top: 24px;
            padding-top: 24px;
        }

        .landing-footer__bottom--mobile a {
            font-size: 0.875rem;
        }
    }
</style>
